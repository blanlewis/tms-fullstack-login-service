type Query {
    login(userId: String!, password: String!): LoginResponse!
    currentUser: LoginResponse!
}

type LoginResponse {
    userId: String
    isLoggedIn: Boolean!
}

type Mutation {
    registerUser(userId: String!, password: String!): RegistrationResponse!
}

type RegistrationResponse {
    userId: String
    isStoredSuccessfully: Boolean!
}
